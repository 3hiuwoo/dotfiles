{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Probe commands before considering Homebrew. An existing non-Homebrew install
# is sufficient; package ownership and upgrades remain the user's choice.
{{ template "command-path.sh" . }}
set --
{{ range .packages.darwin.brews -}}
if ! commands_available{{ range .commands }} {{ . | quote }}{{ end }}; then
    set -- "$@" {{ .name | quote }}
fi
{{ end -}}
if [ "$#" -eq 0 ]; then
    exit 0
fi

brew_command=$(command -v brew || true)
if [ -z "$brew_command" ]; then
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            brew_command=$candidate
            break
        fi
    done
fi

if [ -z "$brew_command" ]; then
    installer=$(mktemp "${TMPDIR:-/tmp}/dotfiles-homebrew.XXXXXX")
    trap 'rm -f "$installer"' EXIT
    curl --fail --silent --show-error --location --retry 3 \
        https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh \
        --output "$installer"
    NONINTERACTIVE=1 /bin/bash "$installer"
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            brew_command=$candidate
            break
        fi
    done
fi
if [ -z "$brew_command" ]; then
    printf '%s\n' 'Homebrew installation failed; install Homebrew and rerun chezmoi apply.' >&2
    exit 1
fi

eval "$("$brew_command" shellenv)"
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_UPGRADE=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
printf 'Installing missing terminal packages with Homebrew: %s\n' "$*"
printf 'brew "%s"\n' "$@" | "$brew_command" bundle --no-upgrade --file=-
{{ end -}}
