#compdef ccs

# Generated by `ccs completion zsh`. Provider/node names are
# resolved dynamically from the provider config file.

_cc_endpoint_switch() {
  local -a subcommands
  subcommands=(
    'status:show the active endpoint'
    'ls:list all providers, nodes and key status'
    'use:switch to a provider/node'
    'official:return to official login (clear relay env vars)'
    'add-provider:create a provider'
    'rm-provider:delete a provider and its nodes'
    'add-node:add a node (domain) to a provider'
    'rm-node:delete a node'
    'set-token:set the provider API key in the secrets file'
    'unset-token:remove the provider API key from the secrets file'
    'set-default:set the default node of a provider'
    'env:activate a relay profile in this terminal (alias: activate)'
    'run:launch claude with a per-session relay override'
    'sync:create or refresh a relay home profile (shared plugins, model picker)'
    'add-model:add a model to a provider home-mode /model picker'
    'rm-model:remove a model from a provider /model picker'
    'unset-model:strip the model key (and env ANTHROPIC_MODEL) from settings.json'
    'completion:print a shell completion script'
    'init:print the shell wrapper so ccs env activates this terminal directly'
  )

  local context state line
  typeset -A opt_args
  _arguments -C '1: :->sub' '*: :->args'

  case $state in
    sub)
      _describe 'command' subcommands
      ;;
    args)
      local cmd=$line[1]
      local -a values

      if [[ $words[CURRENT] == -* ]]; then
        case $cmd in
          use) _values 'option' '--token[key for this run]' '--save-token[persist the key]' ;;
          add-node) _values 'option' '--default[make it the default node]' ;;
          add-provider) _values 'option' '--desc[description note]' '--api-key-env[env var name]' ;;
          add-model) _values 'option' '--label[short picker label]' '--desc[longer picker description]' '--default[preselect as profile default]' ;;
          sync)
            if [[ $words[CURRENT] == --config-dir=* ]]; then
              _directories
            elif [[ $words[CURRENT] == --share=* || $words[CURRENT] == --unshare=* ]]; then
              _values 'entry' 'projects' 'history.jsonl' 'file-history'
            else
              _values 'option' \
                '--config-dir[profile path or auto]:dir:_directories' \
                '--share[also share entries: projects,history.jsonl,file-history]:names:(projects history.jsonl file-history)' \
                '--unshare[stop sharing entries]:names:(projects history.jsonl file-history)'
            fi
            ;;
        esac
        return
      fi

      case $cmd in
        use)
          if (( CURRENT == 3 )); then
            values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
            _describe 'provider' values
          elif (( CURRENT == 4 )); then
            values=(${(f)"$(ccs __complete nodes $words[3] 2>/dev/null)"})
            _describe 'node' values
          fi
          ;;
        env|activate)
          if [[ $words[CURRENT] == --config-dir=* ]]; then
            _directories
          elif [[ $words[CURRENT-1] == --model ]]; then
            values=(${(f)"$(ccs __complete models $words[3] 2>/dev/null)"})
            _describe 'model' values
          elif (( CURRENT == 3 )); then
            if [[ $words[CURRENT] == -* ]]; then
              _values 'option' \
                '--config-dir[home mode: only CLAUDE_CONFIG_DIR is exported (auto or path)]:dir:_directories' \
                '--force-sync[with --config-dir: re-pull shared settings and relink dirs now]' \
                '--model[export ANTHROPIC_MODEL for this terminal (omit value for the provider default)]'
            else
              values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
              values=(${values:#official})
              _describe 'provider' values
            fi
          elif (( CURRENT == 4 )); then
            values=(${(f)"$(ccs __complete nodes $words[3] 2>/dev/null)"})
            _describe 'node' values
          fi
          ;;
        run)
          if [[ $words[CURRENT] == --config-dir=* ]]; then
            _directories
          elif [[ $words[CURRENT] == --method=* ]]; then
            _values 'method' 'auto' 'env' 'file'
          elif [[ $words[CURRENT-1] == --model ]]; then
            values=(${(f)"$(ccs __complete models $words[3] 2>/dev/null)"})
            _describe 'model' values
          elif (( CURRENT == 3 )); then
            if [[ $words[CURRENT] == -* ]]; then
              _values 'option' '--method[credential delivery: auto/env/file]:method:(auto env file)' \
                '--config-dir[home mode: only CLAUDE_CONFIG_DIR (auto or path)]:dir:_directories' \
                '--model[pass the model via ANTHROPIC_MODEL (omit value for the provider default)]'
            else
              values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
              values=(${values:#official})
              _describe 'provider' values
            fi
          elif (( CURRENT == 4 )); then
            values=(${(f)"$(ccs __complete nodes $words[3] 2>/dev/null)"})
            _describe 'node' values
          fi
          ;;
        sync)
          if [[ $words[CURRENT] == --config-dir=* ]]; then
            _directories
          elif (( CURRENT == 3 )); then
            if [[ $words[CURRENT] == -* ]]; then
              _values 'option' '--config-dir[profile path or auto]:dir:_directories'
            else
              values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
              values=(${values:#official})
              _describe 'provider' values
            fi
          elif (( CURRENT == 4 )); then
            values=(${(f)"$(ccs __complete nodes $words[3] 2>/dev/null)"})
            _describe 'node' values
          fi
          ;;
        rm-model)
          if (( CURRENT == 3 )); then
            values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
            values=(${values:#official})
            _describe 'provider' values
          elif (( CURRENT == 4 )); then
            values=(${(f)"$(ccs __complete models $words[3] 2>/dev/null)"})
            _describe 'model' values
          fi
          ;;
        add-model)
          if (( CURRENT == 3 )); then
            values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
            values=(${values:#official})
            _describe 'provider' values
          fi
          ;;
        rm-provider|set-token|unset-token)
          if (( CURRENT == 3 )); then
            values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
            values=(${values:#official})
            _describe 'provider' values
          fi
          ;;
        add-node|rm-node|set-default)
          if (( CURRENT == 3 )); then
            values=(${(f)"$(ccs __complete providers 2>/dev/null)"})
            values=(${values:#official})
            _describe 'provider' values
          elif (( CURRENT == 4 )); then
            values=(${(f)"$(ccs __complete nodes $words[3] 2>/dev/null)"})
            _describe 'node' values
          fi
          ;;
        completion|init)
          if (( CURRENT == 3 )); then
            _values 'shell' 'zsh' 'bash'
          fi
          ;;
      esac
      ;;
  esac
}

_cc_endpoint_switch "$@"

