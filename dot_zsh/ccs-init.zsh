# Generated by `ccs init zsh`.
# Install once:
#   ccs init zsh > ~/.zsh/ccs-init.zsh
#   echo 'source ~/.zsh/ccs-init.zsh' >> ~/.zshrc
# With this wrapper, `ccs env PROVIDER` activates the relay profile in the
# current terminal directly; `ccs-off` restores the previous environment.
ccs() {
  case "$1" in
    env|activate)
      local _ccs_snippet
      _ccs_snippet="$(command ccs "$@")" || return $?
      eval "$_ccs_snippet"
      ;;
    *)
      command ccs "$@"
      ;;
  esac
}

