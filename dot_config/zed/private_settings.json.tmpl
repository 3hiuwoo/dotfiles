{{- $local := dict -}}
{{- $localPath := joinPath .chezmoi.homeDir ".config/zed/chezmoi-local.json" -}}
{{- if stat $localPath -}}
{{- $local = fromJson (include $localPath) -}}
{{- end -}}
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "buffer_font_fallbacks": ["FiraCode Nerd Font Mono"],
  "cli_default_open_behavior": "existing_window",
  "context_servers": {
    "mcp-server-context7": {
      "enabled": {{ if get $local "context7_api_key" }}true{{ else }}false{{ end }},
      "remote": false,
      "settings": {
        "context7_api_key": {{ get $local "context7_api_key" | default "" | toJson }},
      },
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware",
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "allow_all_hosts": true,
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [],
    "single_file_review": true,
    "model_parameters": [],
    "expand_terminal_card": false,
    "expand_edit_card": false,
  },
  "proxy": "",
  "terminal": {
    "copy_on_select": true,
{{ if eq .chezmoi.os "darwin" }}    "option_as_meta": true,
{{ end }}    "font_fallbacks": ["FiraCode Nerd Font Mono"],
  },
  "tabs": {
    "show_diagnostics": "errors",
    "git_status": true,
    "file_icons": true,
  },
  "status_bar": {
    "show_active_file": false,
  },
  "use_smartcase_search": true,
  "markdown_preview": {
    "open_markdown_files_in_preview": false,
  },
  "colorize_brackets": true,
  "format_on_save": "on",
  "vim": {
    "cursor_shape": {
      "normal": "block",
    },
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": false,
  },
  "toolbar": {
    "code_actions": true,
  },
  "minimap": {
    "show": "auto",
  },
  "relative_line_numbers": "disabled",
  "which_key": {
    "enabled": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "helix_mode": false,
  "cursor_animation": {
    "enabled": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "agent_servers": {
    "qoder": {
      "type": "registry",
    },
    "antigravity-acp": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "on",
      },
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Catppuccin Mocha",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
}
