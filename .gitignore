# Do not accidentally commit credentials or machine-local shell overrides.
.DS_Store
**/.DS_Store
*.zwc
__pycache__/
.secrets
dot_secrets*
private_dot_secrets*
.shpotify.cfg
dot_shpotify.cfg*
private_dot_shpotify.cfg*
encrypted_*secrets*
dot_zshenv.local*
dot_zprofile.local*
dot_zshrc.local*
*dot_bashrc.local*
*dot_bash_history*
*dot_bash_sessions/
env.local.sh*
dot_zsh_history*
dot_zcompdump*
dot_cache/
dot_vimrc.local*
dot_viminfo*
dot_vim/.netrwhist
dot_vim/dot_netrwhist
dot_vim/undo/
dot_vim/swap/
dot_vim/backup/
dot_vim/pack/**/.git/
dot_vim/pack/**/doc/tags
.wakatime.cfg
dot_wakatime*
private_dot_wakatime*
dot_local/share/fzf-history/
*.swp
*.swo
*~

# Local Git overrides, Zed credentials, and generated prompt databases.
dot_gitconfig.local*
private_dot_gitconfig.local*
dot_config/zed/*chezmoi-local.json*
dot_config/zed/prompts/
**/*.mdb

# SSH identities, host state, local overrides, and GitHub CLI authentication.
*dot_ssh/*id_*
*dot_ssh/*known_hosts*
*dot_ssh/*authorized_keys*
*dot_ssh/*config.local*
*dot_ssh/agent/
*dot_config/*gh/*hosts.y*

# Agent account/runtime state must never be captured into the source tree.
# .claude.json stays local; settings.json uses a selective modify template.
*dot_agents/*skill-lock.json*
*dot_agents/skills/*/
*dot_claude/skills/
dot_claude.json*
private_dot_claude.json*
*dot_claude/*credentials*
*dot_claude/*settings.local.json*
*dot_claude/projects/
*dot_claude/sessions/
*dot_claude/plugins/
*dot_claude/skills/synced/
*dot_claude/*history*
*dot_claude/cache/
*dot_codex/*auth.json*
*dot_codex/*config.toml*
*dot_codex/*history*
*dot_codex/sessions/
*dot_codex/archived_sessions/
*dot_codex/memories/
*dot_codex/plugins/
*dot_codex/computer-use/
*.sqlite*
