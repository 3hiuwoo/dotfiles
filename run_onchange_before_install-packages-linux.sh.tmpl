{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# Ubuntu/Debian server dependencies only. Never change the login shell or install
# desktop apps, agent CLIs, Homebrew, CUDA, or project-specific Python packages.
{{ template "command-path.sh" . }}
if ! command -v apt-get >/dev/null 2>&1 || ! command -v dpkg-query >/dev/null 2>&1; then
    printf '%s\n' 'The Linux installer supports Debian/Ubuntu (apt). Add a native package list for this distribution first.' >&2
    exit 1
fi

set --
{{ range .packages.linux.apt -}}
{{ if .commands -}}
if ! commands_available{{ range .commands }} {{ . | quote }}{{ end }}; then
{{ else -}}
if [ "$(dpkg-query -W -f='${Status}' {{ .name | quote }} 2>/dev/null || true)" != 'install ok installed' ]; then
{{ end -}}
    set -- "$@" {{ .name | quote }}
fi
{{ end }}

if [ "$#" -gt 0 ]; then
    if [ "$(id -u)" -eq 0 ]; then
        as_root() { "$@"; }
    elif command -v sudo >/dev/null 2>&1; then
        as_root() { sudo "$@"; }
    else
        printf 'Missing server packages: %s\n' "$*" >&2
        printf '%s\n' 'Install these with an administrator, then rerun chezmoi apply.' >&2
        exit 1
    fi
    as_root apt-get update
    as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-upgrade "$@"
fi

# Use the official user-local uv installer only when uv is absent. Do not
# rewrite existing shell startup files or provision Python/project environments.
if ! command -v uv >/dev/null 2>&1; then
    installer=$(mktemp "${TMPDIR:-/tmp}/dotfiles-uv.XXXXXX")
    trap 'rm -f "$installer"' EXIT
    curl --fail --silent --show-error --location --retry 3 \
        https://astral.sh/uv/install.sh --output "$installer"
    UV_INSTALL_DIR="$HOME/.local/bin" UV_NO_MODIFY_PATH=1 sh "$installer"
fi
{{ end -}}
