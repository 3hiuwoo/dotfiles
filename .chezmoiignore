# Only paths that exist in the source state belong here. Ignoring a directory
# also ignores the files chezmoi keeps in its source state, but not files
# supplied by .chezmoiexternal.toml: those need `dir/**`.

# Repository documentation is not a home-directory dotfile.
README.md
tests

{{ if ne .chezmoi.os "darwin" }}
# Agent configuration and desktop applications are Mac-only.
.agents
.claude
.codex
.config/ccstatusline
.grok
.config/ghostty
.config/cmux
.config/zed
.config/rectangle
# Yazi has no apt package for Linux.
.config/yazi
install-packages-darwin.sh
install-agent-skills.sh
rectangle-preferences.sh
{{ end }}

{{ if ne .chezmoi.os "linux" }}
install-packages-linux.sh
.bashrc
.bash_profile
{{ end }}

{{ if eq .chezmoi.os "linux" }}
# Bash is the Linux shell; zsh configuration and external plugins are Mac-only.
.zshenv
.zprofile
.zshrc
.zsh/**
.config/fsh
{{ end }}
